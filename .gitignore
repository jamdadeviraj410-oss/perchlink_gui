# ==========================================
# PerchLink Root .gitignore
# ==========================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/env/

# Databases & Runtime Storage
*.db
*.sqlite3
backend/perchlink.db
backend/perchlink.db-journal

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.eslintcache

# Environment & Secrets
.env
.env.*
!.env.example

# Hardware & Firmware Config Backups
lora-v1_firmware config/
rpi -lora_config/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
